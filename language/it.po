msgstr "[Nessuna azione]"

#: src/Form/EZIDForm.php:15
msgid "EZID configuration"
msgstr "Configurazione EZID"

#: src/Form/EZIDForm.php:29
msgid "NAAN & Shoulder Namespace"
msgstr "NAAN & Shoulder Namespace"

#: src/Form/EZIDForm.php:30
msgid ""
"<a target=\"_blank\" href=\"https://ezid.cdlib.org/learn/id_basics\">Name "
"Assigning Authority Number (NAAN) and shoulder value</a> for your "
"organization. Example: ark:/12345/k4."
msgstr ""
"<a target=\"_blank\" href=\"https://ezid.cdlib.org/learn/id_basics\">Name "
"Assigning Authority Number (NAAN) e shoulder value</a> per la tua "
"organizzazione. Esempio: ark:/12345/k4."

#: src/Form/EZIDForm.php:43
msgid "EZID Username"
msgstr "Nome utente EZID"

#: src/Form/EZIDForm.php:44 src/Form/EZIDForm.php:57
msgid ""
"Ensure user has permission to create and update identifiers for above "
"namespace."
msgstr ""
"Assicurati che l'utente abbia i permessi per creare ed aggiornare gli "
"identificativi nel namespace indicato qui sopra"

#: src/Form/EZIDForm.php:56
msgid "EZID Password"
msgstr "Password EZID"

#: src/Form/LocalARKForm.php:15
msgid "Local ARK configuration"
msgstr "Configurazione ARK locale"

#: src/Form/LocalARKForm.php:29
msgid "NAAN"
msgstr "NAAN"

#: src/Form/LocalARKForm.php:30
msgid ""
"Your organization's <a target=\"_blank\" href=\"https://arks.org/about/ark-"
"naans-and-systems/\">Name Assigning Authority Number (NAAN)</a> as assigned "
"by the ARK Alliance. Example: 12345."
msgstr ""
"Il NAAN (<a target=\"_blank\" href=\"https://arks.org/about/ark-naans-and-"
"systems/\">Name Assigning Authority Number </a>) della tua organizzazione "
"come assegnato dalla ARK Alliance. Ad esempio: 12345."

#: src/Form/LocalARKForm.php:43
msgid "Shoulder"
msgstr ""

#: src/Form/LocalARKForm.php:44
msgid ""
"Optional two character betanumeric prefix appended after the NAAN. Useful "
"for sub-dividing ARKs by project or unit (for example). Generated "
"automatically if left blank."
msgstr ""

#: src/Form/ConfigForm.php:32
msgid "Assign PIDs to new items"
msgstr "Assegna PID a nuovi contenuti"

#: src/Form/ConfigForm.php:33
msgid "Mint and assign PIDs to all newly created or imported items."
msgstr "Crea ed assegna PID a tutti i contenuti creati o importati"

#: src/Form/ConfigForm.php:44
msgid "Fields with existing PIDs"
msgstr "Campi con PID preesistenti"

#: src/Form/ConfigForm.php:45
msgid ""
"List of Omeka S property terms (e.g. dcterms:identifier), separated by "
"commas, that may contain PID values. If found, existing PID will be assigned"
" instead of minting a new PID. Order matters: the first PID found from "
"listed fields will be assigned to item."
msgstr ""

#: src/Form/ConfigForm.php:56
msgid "Optional field to store PIDs"
msgstr "Campo opzionale per i PID"

#: src/Form/ConfigForm.php:57
msgid ""
"If set, PID will also be written to this metadata property within the item."
msgstr ""
"Se impostato, i PID saranno scritti anche in questa proprietà dei metadata "
"del contenuto."

#: src/Form/DataCiteForm.php:25
msgid "DataCite configuration"
msgstr "Configurazione DataCite"

#: src/Form/DataCiteForm.php:39
msgid "Repository DOI Prefix"
msgstr "Prefisso DOI del repository"

#: src/Form/DataCiteForm.php:40
msgid ""
"The <a target=\"_blank\" href=\"https://support.datacite.org/docs/doi-"
"basics#prefix\">DOI prefix</a> associated with your DataCite repository. "
"Example: 10.82157"
msgstr ""
"Il <a target=\"_blank\" href=\"https://support.datacite.org/docs/doi-"
"basics#prefix\">prefisso DOI</a> associato con il tuo repository DataCite. "
"Esempio: 10.82157"

#: src/Form/DataCiteForm.php:53
msgid "DataCite Repository ID"
msgstr "DataCite Repository ID"

#: src/Form/DataCiteForm.php:54
msgid ""
"Unique identifier assigned to your DataCite repository. Example: XQZU.RBBDXB"
msgstr ""
"Identificativo univoco assegnato al tuo repository DataCite. Esempio: "
"XQZU.RBBDXB"

#: src/Form/DataCiteForm.php:66
msgid "DataCite Password"
msgstr "Password DataCite"

#: src/Form/DataCiteForm.php:67
msgid ""
"Password associated with DataCite repository (note that this is different "
"from your DataCite Member password)."
msgstr ""
"Password associata al repository DataCite (N.B. è differente dalla tua "
"password membro di DataCite)."

#: src/Form/DataCiteForm.php:80
msgid "DataCite required metadata"
msgstr "Metadata obbligatori per DataCite"

#: src/Form/DataCiteForm.php:94
msgid "Title property"
msgstr "Proprietà \"titolo\""

#: src/Form/DataCiteForm.php:95
msgid ""
"Local metadata field value to assign to required DataCite title property."
msgstr ""
"Campo di metadata locale da assegnare alla proprietà \"titolo\" richiesta da"
" DataCite"

#: src/Form/DataCiteForm.php:112
msgid "Creators property"
msgstr "Proprietà \"creatori\""

#: src/Form/DataCiteForm.php:113
msgid ""
"Local metadata field value to assign to required DataCite creators property."
msgstr ""
"Campo di metadata locale da assegnare alla proprietà \"creatori\" (creators)"
" richiesta da DataCite"

#: src/Form/DataCiteForm.php:130
msgid "Publisher property"
msgstr "Proprietà \"editore\""

#: src/Form/DataCiteForm.php:131
msgid ""
"Local metadata field value to assign to required DataCite publisher "
"property."
msgstr ""
"Campo metadata locale da assegnare alla proprietà \"editore\" (publisher) "
"richiesta da DataCite"

#: src/Form/DataCiteForm.php:148
msgid "Publication Year property"
msgstr "Proprietà \"anno di pubblicazione\""

#: src/Form/DataCiteForm.php:149
msgid ""
"Local metadata field value to assign to required DataCite publicationYear "
"property. Must be in YYYY format."
msgstr ""
"Campo di metadata locale da assegnare alla proprietà \"anno di "
"pubblicazione\" (publicationYear) richiesta da DataCite"

#: src/Form/DataCiteForm.php:166
msgid "Resource Type General property"
msgstr "Proprietà tipo di risorsa generale (Resource Type General property)"

#: src/Form/DataCiteForm.php:167
msgid ""
"Local metadata field value to assign to required DataCite "
"resourceTypeGeneral property. Must match a <a target=\"_blank\" "
"href=\"https://support.datacite.org/docs/datacite-metadata-"
"schema-v44-mandatory-properties#101-resourcetypegeneral\">controlled "
"resourceTypeGeneral vocabulary</a> value exactly."
msgstr ""
"Campo di metadata locale da assegnare alla proprietà \"tipo di risorsa "
"generale (resourceTypeGeneral) richiesta da DataCite. Deve corrispondere "
"esattamente a uno dei valori del <a target=\"_blank\" "
"href=\"https://support.datacite.org/docs/datacite-metadata-"
"schema-v44-mandatory-properties#101-resourcetypegeneral\">vocabolario "
"controllato resourceTypeGeneral</a>."

#: src/Form/DataCiteForm.php:186
msgid "DataCite optional metadata"
msgstr "Metadata opzionali per DataCite"

#: src/Form/DataCiteForm.php:198
msgid "Subject property"
msgstr "Proprietà del soggetto"

#: src/Form/DataCiteForm.php:199
msgid "Local metadata field to map to DataCite subjects."
msgstr "Campo dei metadata locali corrispondente ai soggetti DataCite."

#: src/Form/DataCiteForm.php:203
msgid "Description property"
msgstr "Proprietà della descrizione"

#: src/Form/DataCiteForm.php:204
msgid ""
"Local metadata field to map to DataCite descriptions (sent as "
"descriptionType \"Abstract\")."
msgstr ""

#: src/Form/DataCiteForm.php:208
msgid "Language property"
msgstr "Proprietà della lingua"

#: src/Form/DataCiteForm.php:209
msgid ""
"Local metadata field to map to DataCite language. Should be a <a "
"target=\"_blank\" "
"href=\"https://en.wikipedia.org/wiki/IETF_language_tag\">BCP-47 language "
"tag</a> (e.g. \"en\")."
msgstr ""

#: src/Form/DataCiteForm.php:213
msgid "Version property"
msgstr ""

#: src/Form/DataCiteForm.php:214
msgid "Local metadata field to map to DataCite version."
msgstr ""

#: src/Form/DataCiteForm.php:218
msgid "Rights property"
msgstr "Proprietà dei diritti"

#: src/Form/DataCiteForm.php:219
msgid ""
"Local metadata field to map to DataCite rightsList. URI-type values will "
"also populate rightsUri."
msgstr ""

#: src/Form/DataCiteForm.php:223
msgid "Size property"
msgstr "Proprietà della dimensione"

#: src/Form/DataCiteForm.php:224
msgid ""
"Local metadata field to map to DataCite sizes (e.g. \"1.2 MB\", \"100 "
"pages\")."
msgstr ""

#: src/Form/DataCiteForm.php:228
msgid "Format property"
msgstr "Proprietà del formato"

#: src/Form/DataCiteForm.php:229
msgid ""
"Local metadata field to map to DataCite formats (e.g. \"application/pdf\")."
msgstr ""
"Campo dei metadata locali da associare ai formati DataCite (ad esempio "
"\"application/pdf\")."

