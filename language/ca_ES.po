#: view/persistent-identifiers/common/pid-edit-form.phtml:35
#, php-format
msgid ""
"<strong>Warning</strong>: this action will remove <strong>%s</strong> from "
"item <strong>%s</strong>, breaking any incoming Omeka URI links, and cannot "
"be undone."
msgstr ""
"<strong>Alerta</strong>: aquesta acció suprimirà <strong>%s</strong> del "
"recurs <strong>%s</strong>, eliminant qualsevol enllaç entrant, i no es pot "
"desfer."

#: view/persistent-identifiers/common/pid-edit-form.phtml:39
msgid "Are you sure you would like to remove the PID from this item?"
msgstr "Esteu segur que voleu suprimir el PID d'aquest recurs?"

#: view/persistent-identifiers/common/pid-edit-form.phtml:40
